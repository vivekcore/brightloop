enum BillingInterval {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model Product {
  id          String           @id @default(uuid())
  name        String
  type        String
  salesPrice  Decimal          @db.Decimal(12, 2)
  costPrice   Decimal          @db.Decimal(12, 2)
  notes       String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  variants    ProductVariant[]
  plans       Plan[]

  @@map("product")
}

model ProductVariant {
  id              String   @id @default(uuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeName   String
  value           String
  priceAdjustment Decimal  @default(0) @db.Decimal(12, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([productId, attributeName, value])
  @@index([productId])
  @@index([productId, isActive])
  @@map("product_variant")
}

model Plan {
  id              String          @id @default(uuid())
  productId       String
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String
  price           Decimal         @db.Decimal(12, 2)
  billingInterval BillingInterval
  minimumQuantity Int             @default(1)
  availableFrom   DateTime?
  availableUntil  DateTime?
  autoCloseAtEnd  Boolean         @default(false)
  allowEarlyClose Boolean         @default(false)
  allowPause      Boolean         @default(false)
  allowRenewal    Boolean         @default(false)
  isActive        Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  quotationTemplates QuotationTemplate[]
  subscriptions      Subscription[]

  @@index([productId])
  @@index([billingInterval])
  @@index([isActive, availableFrom, availableUntil])
  @@map("plan")
}
