{
  "name": "brightloop",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:seed:admin": "tsx scripts/provision-admin.ts"
  },
  "devDependencies": {
    "dotenv": "^18.0.9",
    "prettier": "3.9.6",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.11"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "scripts"
  ]
}
